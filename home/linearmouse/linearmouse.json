{
  "$schema": "https://schema.linearmouse.app/0.12.0",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "mouse"
        }
      },
      "scrolling": {
        "smoothed": {
          "enabled": true,
          "preset": "easeInOut",
          "response": 0.45,
          "speed": 1,
          "acceleration": 1.2,
          "inertia": 0.65,
          "bouncing": false
        }
      }
    }
  ]
}
